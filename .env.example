# ═══════════════════════════════════════════════════════════════════
# SportsCenterSystem — Primjer .env datoteke
# ═══════════════════════════════════════════════════════════════════
# KOPIRATI U .env FAJL I POPUNITI VRIJEDNOSTI

# ── MySQL Konfiguracija ──────────────────────────────────────────────
DB_ROOT_PASSWORD=
DB_USER=
DB_PASSWORD=

# ── User Service ─────────────────────────────────────────────────────
USER_SERVICE_PORT=
USER_SERVICE_HOST=
USER_DB_PORT=
USER_DB_NAME=
USER_DB_HOST=
USER_DB_URL=

# ── Resource Service ─────────────────────────────────────────────────
RESOURCE_SERVICE_PORT=
RESOURCE_SERVICE_HOST=
RESOURCE_DB_PORT=
RESOURCE_DB_NAME=
RESOURCE_DB_HOST=
RESOURCE_DB_URL=

# ── Booking Service ──────────────────────────────────────────────────
BOOKING_SERVICE_PORT=
BOOKING_SERVICE_HOST=
BOOKING_DB_PORT=
BOOKING_DB_NAME=
BOOKING_DB_HOST=
BOOKING_DB_URL=

# ── Payment Service ──────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=
PAYMENT_SERVICE_HOST=
PAYMENT_DB_PORT=
PAYMENT_DB_NAME=
PAYMENT_DB_HOST=
PAYMENT_DB_URL=

# ── Hibernate/JPA ────────────────────────────────────────────────────
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true


# ── Spring Cloud (Z4) ────────────────────────────────────────────────
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080
EUREKA_URL=http://localhost:8761/eureka/
RESOURCE_SERVICE_PORT_2=8092
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# ── JWT / Security (RS256 — asymmetric) ──────────────────────────────
# Private key is held ONLY by the User Service. Public key goes to verifiers
# (API Gateway). Never put the private key into any other microservice.
JWT_PRIVATE_KEY_PATH=file:./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=file:./keys/jwt-public.pem
JWT_ISSUER=sports-center-user-service
JWT_AUDIENCE=sports-center-api
JWT_KID=sports-key-1
# Access token TTL (seconds). Recommended: 900 (15 min).
JWT_ACCESS_EXPIRATION=900
# Refresh token TTL (seconds). Recommended: 604800 (7 days).
JWT_REFRESH_EXPIRATION=604800
# Shared secret that protects the gateway /internal/revoke endpoint.
INTERNAL_SECRET=
GATEWAY_INTERNAL_REVOKE_URL=http://localhost:8080/internal/revoke
# Per-IP rate limit on POST /api/auth/login
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
# Frontend dev origins allowed by the API Gateway CORS filter
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# ── RabbitMQ (Z7 — Saga Choreography) ────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
