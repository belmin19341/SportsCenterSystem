# ═══════════════════════════════════════════════════════════════════
# SportsCenterSystem — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values before running.
#
#   cp .env.example .env
#
# All defaults below work out-of-the-box for local Docker development.
# Only STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY and INTERNAL_SECRET
# require real values (see comments for each).
# ═══════════════════════════════════════════════════════════════════

# ── MySQL ────────────────────────────────────────────────────────────
# Root password for the MySQL containers (only used by Docker init)
DB_ROOT_PASSWORD=rootpassword
# Application DB user (must match DataLoader seed expectations)
DB_USER=sportcenter
DB_PASSWORD=sportcenter123

# ── User Service ─────────────────────────────────────────────────────
USER_SERVICE_PORT=8081
USER_SERVICE_HOST=localhost
USER_DB_PORT=3307
USER_DB_NAME=sportcenter_user_db
USER_DB_HOST=localhost
# Leave blank — docker-compose builds the JDBC URL from the variables above
USER_DB_URL=

# ── Resource Service ─────────────────────────────────────────────────
RESOURCE_SERVICE_PORT=8082
RESOURCE_SERVICE_HOST=localhost
RESOURCE_DB_PORT=3308
RESOURCE_DB_NAME=sportcenter_resource_db
RESOURCE_DB_HOST=localhost
RESOURCE_DB_URL=

# ── Booking Service ──────────────────────────────────────────────────
BOOKING_SERVICE_PORT=8083
BOOKING_SERVICE_HOST=localhost
BOOKING_DB_PORT=3309
BOOKING_DB_NAME=sportcenter_booking_db
BOOKING_DB_HOST=localhost
BOOKING_DB_URL=

# ── Payment Service ──────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=8084
PAYMENT_SERVICE_HOST=localhost
PAYMENT_DB_PORT=3310
PAYMENT_DB_NAME=sportcenter_payment_db
PAYMENT_DB_HOST=localhost
PAYMENT_DB_URL=

# ── Hibernate / JPA ──────────────────────────────────────────────────
# "update" — Hibernate auto-creates / migrates tables on startup.
# Change to "validate" or "none" in production.
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ── Spring Cloud ─────────────────────────────────────────────────────
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080
EUREKA_URL=http://localhost:8761/eureka/
# Second Resource Service instance port (load-balancing demo)
RESOURCE_SERVICE_PORT_2=8092
# Docker: maps nginx container port 80 to this host port
FRONTEND_PORT=80
# URL the React SPA uses to reach the API Gateway
VITE_API_BASE_URL=http://localhost:8080

# ── JWT / Security (RS256 asymmetric) ────────────────────────────────
# RSA private key — held ONLY by User Service (the token issuer).
# RSA public key  — used by API Gateway for inbound token validation.
# Generate a fresh key pair:  bash scripts/gen-jwt-keys.sh
JWT_PRIVATE_KEY_PATH=classpath:keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/jwt-public.pem
JWT_ISSUER=sports-center-user-service
JWT_AUDIENCE=sports-center-api
JWT_KID=sports-key-1
# Access token TTL in seconds (default 15 minutes)
JWT_ACCESS_EXPIRATION=900
# Refresh token TTL in seconds (default 7 days)
JWT_REFRESH_EXPIRATION=604800
# Shared secret that protects the internal /internal/revoke endpoint.
# Must be the same value in User Service and API Gateway.
# Change this to a strong random string before deploying.
INTERNAL_SECRET=CHANGE_ME_INTERNAL_SECRET_DEV_ONLY
GATEWAY_INTERNAL_REVOKE_URL=http://localhost:8080/internal/revoke

# ── Rate Limiting (API Gateway) ───────────────────────────────────────
# Per-IP fixed-window rate limit on POST /api/auth/login
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of origins the Gateway CORS filter allows.
FRONTEND_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── RabbitMQ (Saga choreography) ─────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── Stripe (Payment Service) ─────────────────────────────────────────
# Get free test keys at https://dashboard.stripe.com/test/apikeys
# Secret key (server-side only, never expose):  sk_test_...
# Publishable key (safe for browser):           pk_test_...
#
# Leave both empty to run in fallback mode — all payments are
# auto-approved without contacting Stripe (useful for quick demos).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
