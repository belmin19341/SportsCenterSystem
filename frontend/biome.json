{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSpacing": false,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"domains": {
			"project": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": "error",
			"performance": "error",
			"recommended": true,
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"overrides": [
		{
			"includes": ["**/*"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off"
					},
					"correctness": {
						"useImportExtensions": "off",
						"noUnresolvedImports": "off",
						"useQwikValidLexicalScope": "off",
						"useUniqueElementIds": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off",
						"noVoid": "off"
					},
					"nursery": {
						"noHexColors": "off",
						"useExplicitType": "off",
						"useBaseline": "off",
						"useDestructuring": "off",
						"noJsxPropsBind": "off",
						"noTernary": "off",
						"useUnicodeRegex": "off",
						"useGlobalThis": "off",
						"useSortedClasses": "off"
					},
					"performance": {
						"noBarrelFile": "off",
						"noImgElement": "off",
						"noReExportAll": "off",
						"useSolidForComponent": "off",
						"useTopLevelRegex": "off"
					},
					"style": {
						"noMagicNumbers": "off",
						"noNestedTernary": "off",
						"useComponentExportOnlyModules": "off",
						"useExportsLast": "off",
						"useNamingConvention": "off",
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"filenameCases": ["camelCase", "kebab-case", "PascalCase"]
							}
						},
						"noJsxLiterals": "off"
					},
					"security": {
						"noSecrets": {
							"level": "error",
							"options": {
								"entropyThreshold": 100
							}
						}
					}
				}
			}
		},
		{
			"includes": ["vite.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					},
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
